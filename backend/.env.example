# All backend settings with their default values. Copy to .env, change what you need and run
#   ./.venv/bin/uvicorn app.main:app --env-file .env
# or set the same variables in the environment of the server.

# Folder for the database and the images (created at start).
DEBLUR_DATA_DIR=data
# Largest upload, in MB (413 above it).
DEBLUR_MAX_UPLOAD_MB=15
# Larger side of the working copy and of the preview, in pixels.
DEBLUR_FULL_SIDE=1600
DEBLUR_PREVIEW_SIDE=512
# Origins of the frontend allowed by CORS, as a JSON list.
DEBLUR_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# DEBUG, INFO, WARNING or ERROR.
DEBLUR_LOG_LEVEL=INFO
# Photos older than this are deleted at startup, unless they are in the gallery.
DEBLUR_PHOTO_TTL_HOURS=24
# Render jobs that may wait in the queue; one more gets 429.
DEBLUR_MAX_QUEUED_JOBS=5
